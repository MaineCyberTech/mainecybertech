www.mainecybertech.com, app.mainecybertech.com {
    tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem

    reverse_proxy web:3000

    header / {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'"
    }
}

api.mainecybertech.com {
    tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem

    @sse path /api/v1/notifications/stream
    reverse_proxy @sse api:4000 {
        flush_interval -1
    }
    reverse_proxy api:4000

    header / {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'"
    }
}

