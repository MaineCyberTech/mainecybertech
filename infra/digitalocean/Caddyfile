# Default Caddyfile (prod-equivalent security headers; used as deploy fallback)

www.mainecybertech.com, app.mainecybertech.com {
    tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem

    reverse_proxy web:3000

    header / {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    }
}

api.mainecybertech.com {
    tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem

    # Prometheus scrapes this internally; never expose it publicly.
    @metrics path /metrics
    respond @metrics 404

    @sse path /api/v1/notifications/stream
    reverse_proxy @sse api:4000 {
        flush_interval -1
    }
    reverse_proxy api:4000

    header / {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    }
}

