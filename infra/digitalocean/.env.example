# Copy to .env and fill in real values: cp .env.example .env
# Hosted Supabase (https://supabase.com/dashboard) — required
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=your-jwt-secret

# CORS origins allowed to call the API (comma-separated)
CORS_ORIGIN=https://app.mainecybertech.com,https://www.mainecybertech.com

# Domains used to build APP_BASE_URL / API_BASE_URL
APP_DOMAIN=app.mainecybertech.com
API_DOMAIN=api.mainecybertech.com

# Redis — REQUIRED (no fallback). Use a strong random value in production, e.g.:
#   openssl rand -hex 32
REDIS_PASSWORD=change-me-to-a-long-random-value

# Image tag + prefix used by compose (deploy workflow sets these automatically)
IMAGE_TAG=latest
GHCR_IMAGE_PREFIX=ghcr.io/mainecybertech/mainecybertech

# Optional — Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional — Sentry
SENTRY_DSN=

# Optional — SMTP (worker email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@mainecybertech.com

# Optional — Jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Optional — JSM (contact form tickets)
JSM_BASE_URL=
JSM_DOMAIN=
JSM_EMAIL=
JSM_API_TOKEN=
JSM_SERVICEDESK_ID=
JSM_REQUEST_TYPE_ID=

# Optional — M365 calendar sync
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# Optional — public contact form webhooks (Teams)
PUBLIC_TRAFFIC_WEBHOOK_URL=
PUBLIC_LEAD_WEBHOOK_URL=

# Optional — RLS gating enabler (MT-P0-001). Leave empty to keep the API on
# the service-role client (current behavior). Set to a comma-separated list of
# module keys to switch those modules to the user-scoped client at runtime.
# Reads and writes are gated independently; e.g. set RLS_READS_ENABLED first,
# validate, then RLS_WRITES_ENABLED. See docs/MT-P0-001-RLS-remediation-design.md.
RLS_READS_ENABLED=
RLS_WRITES_ENABLED=
