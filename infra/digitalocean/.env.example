# Copy to .env and fill in real values: cp .env.example .env
# Hosted Supabase (https://supabase.com/dashboard) — required
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=your-jwt-secret

# CORS origins allowed to call the API (comma-separated)
CORS_ORIGIN=https://app.mainecybertech.com,https://www.mainecybertech.com

# Domains used to build APP_BASE_URL / API_BASE_URL
APP_DOMAIN=app.mainecybertech.com
API_DOMAIN=api.mainecybertech.com

# Redis — REQUIRED (no fallback). Use a strong random value in production, e.g.:
#   openssl rand -hex 32
REDIS_PASSWORD=change-me-to-a-long-random-value

# Image tag + prefix used by compose (deploy workflow sets these automatically)
IMAGE_TAG=latest
GHCR_IMAGE_PREFIX=ghcr.io/mainecybertech/mainecybertech

# Digest-pinned app image refs. deploy-do.yml resolves each tag to its verified
# digest and sets these; manual operators normally leave them empty and rely on
# IMAGE_TAG. Format: <prefix>/mct-api@sha256:<digest>
MCT_API_IMAGE=
MCT_WORKER_IMAGE=
MCT_WEB_IMAGE=

# Queue backend (ARCH-P2-004). The API producer and the worker consumer both
# read this and refuse anything but `bullmq` in production — leave as-is.
QUEUE_BACKEND=bullmq

# Optional — Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional — Sentry
SENTRY_DSN=
# Release marker (deploy writes the commit SHA / image tag; empty = no release
# correlation in Sentry)
SENTRY_RELEASE=
# Web client bundle DSN (build arg + web runtime)
NEXT_PUBLIC_SENTRY_DSN=

# Optional — SMTP (worker email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@mainecybertech.com

# Optional — Jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Verifies inbound Jira webhooks (shared with Jira; unset = webhook rejected)
JIRA_WEBHOOK_SECRET=

# Optional — JSM (contact form tickets)
JSM_BASE_URL=
JSM_DOMAIN=
JSM_EMAIL=
JSM_API_TOKEN=
JSM_SERVICEDESK_ID=
JSM_REQUEST_TYPE_ID=
# Verifies inbound JSM webhooks (unset = webhook rejected)
JSM_WEBHOOK_SECRET=

# Optional — M365 calendar sync
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
# Microsoft Graph change-notification clientState (WH-P1-002: the deploy
# pipeline delivers this; the webhook is rejected when it is missing)
M365_CLIENT_STATE=

# Optional — public contact form webhooks (Teams)
PUBLIC_TRAFFIC_WEBHOOK_URL=
PUBLIC_LEAD_WEBHOOK_URL=

# Optional — Cloudflare Turnstile captcha for the public contact form
TURNSTILE_SECRET_KEY=

# Optional — AES-256-GCM key for encrypted profile PII (use a real key in production)
FIELD_ENCRYPTION_KEY=

# Optional — MFA enforcement (empty/false = users may enrol but MFA is not required)
MFA_ENFORCEMENT_ENABLED=false

# Optional — Web Push (NOTIF-P2-001). The API hands the public key to browsers,
# the worker signs with the private key; unset or partial = push is a no-op.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional — upload malware scanning (FILE-P2-003). Unset = no-op; point at a
# ClamAV sidecar or VirusTotal proxy.
MALWARE_SCANNER_URL=
MALWARE_SCANNER_API_KEY=

# ---------------------------------------------------------------------------
# Metrics + alerting (INFRA-P3-006). The deploy pipeline writes these from
# GitHub secrets; manual operators must set them or the scrape/alerting path
# degrades silently.
# ---------------------------------------------------------------------------

# REQUIRED for the authenticated Prometheus scrape (OBS-P2-013). Must match the
# bearer token Prometheus reads from the metrics-token file; empty in
# production fails the deploy (the API 404s /metrics and MCTServiceDown fires).
METRICS_TOKEN=

# REQUIRED in production (IR-P0-003): the external dead-man's-switch receiver.
# Must be an off-box URL (healthchecks.io-style) — a loopback URL defeats it.
ALERTMANAGER_WATCHDOG_WEBHOOK_URL=
# Optional — critical/default alert receivers (ntfy relay / Slack). Empty
# values fall back to a no-op loopback URL in compose.
ALERTMANAGER_CRITICAL_WEBHOOK_URL=
ALERTMANAGER_DEFAULT_WEBHOOK_URL=
ALERTMANAGER_SLACK_API_URL=
ALERTMANAGER_SLACK_CHANNEL="#alerts"
# Basic-auth credentials for the critical/default webhooks (ntfy relay user)
ALERTMANAGER_WEBHOOK_USER=
ALERTMANAGER_WEBHOOK_PASS=

# Optional — RLS gating enabler (MT-P0-001). Leave empty to keep the API on
# the service-role client (current behavior). Set to a comma-separated list of
# module keys to switch those modules to the user-scoped client at runtime.
# Reads and writes are gated independently; e.g. set RLS_READS_ENABLED first,
# validate, then RLS_WRITES_ENABLED. See docs/MT-P0-001-RLS-remediation-design.md.
RLS_READS_ENABLED=
RLS_WRITES_ENABLED=
