# Baseline thresholds for .github/workflows/db-restore-test.yml
#
# The restore test asserts these floors so a truncated, empty, stale, or
# policy-stripped dump FAILS the run instead of silently reporting success
# (audit findings DR-P0-002, IR-P1-004). This file is the definition of a
# "verified" backup (see docs/INCIDENT_RESPONSE.md §4.3).
#
# Keep these in sync when migrations add or remove public tables. To override
# without editing the file, set the repository variables RESTORE_MIN_TABLES,
# RESTORE_MIN_ROWS, RESTORE_MIN_MIGRATIONS and/or RESTORE_MAX_DATA_AGE_DAYS
# (Settings -> Secrets and variables -> Actions -> Variables); the workflow
# prefers those when present.
#
# RESTORE_MIN_TABLES:       minimum count of restored public-schema tables.
# RESTORE_MIN_ROWS:         minimum total rows across the critical tables
#                           (profiles, organizations, tickets, documents,
#                           audit_logs).
# RESTORE_MIN_MIGRATIONS:   minimum rows in supabase_migrations.schema_migrations
#                           (proves the dump carries its migration ledger).
# RESTORE_MAX_DATA_AGE_DAYS: maximum age in days of the newest audit_logs row
#                           (proves the dump is fresh — an RPO canary).
# RESTORE_MAX_TABLES_WITHOUT_RLS: maximum count of restored public tables with
#                           RLS disabled (a policy-stripped dump must fail).
RESTORE_MIN_TABLES=120
RESTORE_MIN_ROWS=1
RESTORE_MIN_MIGRATIONS=1
RESTORE_MAX_DATA_AGE_DAYS=2
RESTORE_MAX_TABLES_WITHOUT_RLS=0
