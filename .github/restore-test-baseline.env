# Baseline thresholds for .github/workflows/db-restore-test.yml
#
# The restore test asserts these floors so a truncated, empty, or partial dump
# FAILS the run instead of silently reporting success (audit finding DR-P0-002).
#
# Keep these in sync when migrations add or remove public tables. To override
# without editing the file, set the repository variables RESTORE_MIN_TABLES
# and/or RESTORE_MIN_ROWS (Settings -> Secrets and variables -> Actions ->
# Variables); the workflow prefers those when present.
#
# RESTORE_MIN_TABLES: minimum count of restored public-schema tables.
# RESTORE_MIN_ROWS:   minimum total rows across the critical tables
#                     (profiles, organizations, tickets, documents, audit_logs).
RESTORE_MIN_TABLES=120
RESTORE_MIN_ROWS=1
