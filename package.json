{
  "name": "mct-portal",
  "private": true,
  "license": "ISC",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "e2e": "pnpm --filter=web e2e",
    "format": "prettier --write .",
    "backfill:profile-pii": "node scripts/backfill-profile-pii.mjs",
    "prepare": "husky",
    "ci": "pnpm install --frozen-lockfile && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "supabase:env:sync": "powershell -ExecutionPolicy Bypass -File ./scripts/sync_supabase_env.auto.v2.ps1 -UseNpx -Framework nextjs -EnvFile .env.local",
    "dev:autoenv": "powershell -ExecutionPolicy Bypass -File ./scripts/start_project_with_supabase_env.ps1 -UseNpx -Framework nextjs -EnvFile .env.local -Command \"npm run dev\"",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o docs/storybook-static",
    "chromatic": "chromatic --project-token=$CHROMATIC_PROJECT_TOKEN"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/addon-links": "^8.6.18",
    "@storybook/blocks": "^8.6.18",
    "@storybook/nextjs": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "chromatic": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "pg": "^8.21.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "storybook": "^8.6.18",
    "supabase": "^2.107.0",
    "turbo": "^2.9.18",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli"
    ],
    "overrides": {
      "postcss": ">=8.5.10",
      "js-yaml": ">=4.3.0",
      "@opentelemetry/core": ">=2.8.0",
      "esbuild": ">=0.28.1",
      "form-data": ">=4.0.6",
      "multer": "2.2.0",
      "fast-uri": ">=4.1.2",
      "minimatch@>=10.0.0>brace-expansion": ">=5.0.9",
      "uuid": ">=11.1.1",
      "body-parser@<1.20.6": ">=1.20.6",
      "sharp@<0.35.0": ">=0.35.0",
      "postcss@<=8.5.17": ">=8.5.18",
      "image-size": ">=2.0.0",
      "nanoid": ">=3.3.18"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,md}": [
      "prettier --write"
    ]
  }
}
