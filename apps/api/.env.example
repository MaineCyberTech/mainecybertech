NODE_ENV=development
LOG_LEVEL=debug
API_PORT=4000
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=<your-local-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-local-service-role-key>
JWT_SECRET=<your-jwt-secret>
CORS_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000
# Public domains used by the production Caddy reverse proxy / deploy .env
APP_DOMAIN=app.mainecybertech.com
API_DOMAIN=api.mainecybertech.com
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_RELEASE=
PUBLIC_TRAFFIC_WEBHOOK_URL=
PUBLIC_LEAD_WEBHOOK_URL=
JSM_DOMAIN=
JSM_EMAIL=
JSM_API_TOKEN=
JSM_SERVICEDESK_ID=
JSM_REQUEST_TYPE_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@mainecybertech.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
JIRA_WEBHOOK_SECRET=
JSM_WEBHOOK_SECRET=
M365_WEBHOOK_SECRET=
# Shared clientState validated on inbound M365 webhook notifications
M365_CLIENT_STATE=
# AES-256-GCM key for encrypted profile PII (falls back to a dev `plain:` marker when unset)
FIELD_ENCRYPTION_KEY=
# When set, GET /metrics requires `Authorization: Bearer <token>` (404 otherwise)
METRICS_TOKEN=
# When true, an aal1 session with a verified TOTP factor is rejected with 403 MFA_REQUIRED
MFA_ENFORCEMENT_ENABLED=false
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
TASK_QUEUE_ENABLED=false
TURNSTILE_SECRET_KEY=
# --- RLS client-swap feature flags (MT-P0-001 Phase 2/3) ---
# Empty by default: the API uses the service-role client (RLS bypassed) everywhere,
# identical to prior behavior. Set a comma-separated module key list to make that
# module's read/write paths use the user-scoped (RLS-enforced) client instead.
# Module keys match the `getScopedClient(req, "<key>", kind)` calls in the route files
# (e.g. knowledge-base, tickets, projects). Verify the module's tables have
# member-scoped policies on the hosted DB before enabling. See
# docs/MT-P0-001-RLS-remediation-design.md §10 for the readiness list.
RLS_READS_ENABLED=
RLS_WRITES_ENABLED=

