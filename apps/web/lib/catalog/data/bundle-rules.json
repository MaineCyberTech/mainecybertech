        "mct_business_care"
      ]
    },
    {
      "id": "network_camera_path",
      "whenCategoryViewed": "Wi-Fi & Networking",
      "recommend": [
        "business_network_foundation",
        "camera_and_wi_fi_bundle",
        "unifi_monthly_management"
      ]
    },
    {
      "id": "website_path",
      "whenCategoryViewed": "Website & SEO",
      "recommend": [
        "local_business_online_presence_pack",
        "monthly_website_care_plan",
        "monthly_local_seo_plan"
      ]
    },
    {
      "id": "resilience_path",
