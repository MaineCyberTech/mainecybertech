  "checkoutPolicy": {
    "directCheckoutEligible": "Low-risk quick fixes with no privileged access and no onsite assessment may be direct checkout.",
    "consultationRequired": "Elevated-risk, emergency, monthly plan, DNS/domain, tenant, backup restore, offboarding, network change, camera, and compliance projects should require consult or signed authorization.",
    "neverCollectInPublicForms": [
      "passwords",
      "API keys",
      "MFA recovery codes",
      "backup seed phrases",
      "private keys",
      "full card data",
      "sensitive regulated records"
    ]
  }
