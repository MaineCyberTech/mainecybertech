NEXT_PUBLIC_API_URL=http://localhost:4000
# Public web origin for absolute auth redirects (falls back to request origin).
# APP_BASE_URL=https://app.mainecybertech.us
# Server-side API base URL, read at runtime (server components/actions only).
# Compose sets this to http://api:4000 inside the droplet; leave unset locally
# to fall back to NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_RELEASE=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_TAWKTO_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Client-side logging and build metadata (all optional)
NEXT_PUBLIC_LOG_LEVEL=info
NEXT_PUBLIC_LOG_ENDPOINT=
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_GIT_SHA=
NEXT_PUBLIC_BUILD_TIME=

# Show the /test-accounts dev login page (never enable in production)
NEXT_PUBLIC_TEST_ACCOUNTS_ENABLED=false
# NEXT_PUBLIC_TEST_ACCOUNT_PASSWORD=          # test accounts only — never set in production/CI

# Alga PSA ticket intake (ADR 0001). Leave disabled until the cutover runbook
# docs/runbooks/ALGA-PSA-INTAKE.md is complete. Values are placeholders only;
# never commit a real API key. All IDs are tenant UUIDs from Alga PSA.
ALGA_PSA_INTAKE_ENABLED=false
ALGA_PSA_BASE_URL=https://psa.mainecybertech.us/api/v1
ALGA_PSA_API_KEY=
ALGA_PSA_CLIENT_ID=
ALGA_PSA_BOARD_ID=
ALGA_PSA_STATUS_ID=
ALGA_PSA_PRIORITY_ID=
# Optional JSON map of portal priority -> PSA priority UUID. When set, all four
# keys are required; an invalid/partial map disables intake (fail closed).
# ALGA_PSA_PRIORITY_MAP={"low":"<uuid>","normal":"<uuid>","high":"<uuid>","urgent":"<uuid>"}
# Optional JSON allowlist for multi-tenant portals:
# {"<portal-organization-uuid>":"<alga-client-uuid>"}. When set, only mapped
# portal organizations are routed to the PSA; unmapped organizations keep the
# existing Supabase path. Required before enabling intake for more than one
# portal tenant.
# ALGA_PSA_CLIENT_MAP={"00000000-0000-0000-0000-000000000000":"00000000-0000-0000-0000-000000000000"}
