# Worker environment template.
# Every variable listed here maps 1:1 to the Zod schema in apps/worker/src/env.ts.
# Required
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=<your-local-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-local-service-role-key>

# Queue (defaults shown; BullMQ is the default backend)
QUEUE_BACKEND=bullmq
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
TASK_QUEUE_ENABLED=true
SQS_QUEUE_URL=

# Runtime
WORKER_CONCURRENCY=10
WORKER_TIMEOUT=30000
HEALTH_PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Optional integrations (consumed by worker task handlers)
STRIPE_SECRET_KEY=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JSM_BASE_URL=
JSM_EMAIL=
JSM_API_TOKEN=
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@mainecybertech.com
API_BASE_URL=http://localhost:4000
SENTRY_DSN=
