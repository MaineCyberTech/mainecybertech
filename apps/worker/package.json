    "ioredis": "^5.6.0",
    "nodemailer": "^9.0.1",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "ws": "^8.21.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^22.10.2",
